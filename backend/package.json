{
  "name": "earlyedge-backend",
  "version": "1.0.0",
  "description": "Express and MongoDB backend for EarlyEdge.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/models.unit.test.js tests/userModel.test.js tests/jobModel.test.js tests/applicationModel.test.js tests/squadModel.test.js tests/utils.test.js",
