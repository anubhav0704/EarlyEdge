# EarlyEdge Backend Production Environment Variables (for Render)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Database Connection URI (Render can use either MONGO_URI or MONGODB_URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/earlyedge?retryWrites=true&w=majority

# Secret key for JWT Authentication tokens (Generate any 32+ char random string)
JWT_SECRET=earlyedge_production_jwt_secret_key_2026

# Allowed Frontend URL(s) on Vercel (comma-separated if multiple, or * for all)
CLIENT_URL=https://your-earlyedge-app.vercel.app,http://localhost:5173

# Optional: Groq AI Model API Key for Sage AI Career Coach & Mock Interviews
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
