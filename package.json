{
  "name": "earlyedge-merv-app",
  "version": "1.0.0",
  "description": "MERN Stack migration for the EarlyEdge Merit-First Hiring Platform.",
  "main": "server.js",
  "scripts": {
    "backend-install": "npm install --prefix backend",
    "frontend-install": "npm install --prefix frontend",
    "install-all": "npm install && npm run backend-install && npm run frontend-install",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "test": "npm run test --prefix backend"
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}
